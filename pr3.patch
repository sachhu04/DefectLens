diff --git a/.envrc b/.envrc
new file mode 100644
index 0000000..9d2e101
--- /dev/null
+++ b/.envrc
@@ -0,0 +1,19 @@
+# direnv environment for DefectLens.
+# Requires direnv (https://direnv.net) — macOS (brew install direnv), NixOS,
+# or WSL. Native Windows has no direnv: use WSL, or activate the venv manually
+# (.venv\Scripts\activate on Windows, .venv/bin/activate elsewhere).
+# First use in a fresh clone: `direnv allow`
+
+# 1) NixOS / nix-capable machines: enter the flake devshell
+#    (nodejs + python3 + uv for the frontend and venv bootstrap).
+#    Skipped automatically when nix is not installed (macOS/Windows without nix).
+if command -v nix >/dev/null 2>&1 && [ -f flake.nix ]; then
+    use flake
+fi
+
+# 2) Project Python venv. Kept last so .venv/bin wins over the flake shell's
+#    binaries — all project deps (torch, fastapi, ...) live in .venv.
+if [ -d .venv/bin ]; then
+    PATH_add .venv/bin
+    export VIRTUAL_ENV="$PWD/.venv"
+fi
